    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.5",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.7",
    "expo-status-bar": "~2.0.1",
    "lucide-react-native": "^0.475.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
