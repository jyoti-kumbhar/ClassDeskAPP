{
  "expo": {
    "name": "ClassDesk",
    "slug": "classdesk",
    "version": "1.0.0",
    "newArchEnabled": false,
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#386AEB"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.classdesk.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#386AEB"
      },
      "permissions": [
        "INTERNET",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#386AEB"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5379697f-eafa-4016-bb89-335e8bf0bce2"
      }
    },
    "owner": "kumbharjyoti"
  }
}
