# ============================================================================
# CLASSDESK - PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your production Supabase credentials.
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit your .env file to version control.
# 2. ONLY use the public anon key (EXPO_PUBLIC_SUPABASE_ANON_KEY).
# 3. NEVER put the Supabase service-role key or private secrets in this file or Expo code.
# ============================================================================

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (found in Supabase Dashboard -> Project Settings -> API)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

